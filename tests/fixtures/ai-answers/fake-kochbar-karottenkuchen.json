	"steps": [
		{
			"text": "Den Backofen auf 180 Grad vorheizen und den Boden einer kleiner Springform mit Backpapier auslegen und die Ränder gut einbuttern.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Die Butter mit dem Zucker schaumig rühren und die beiden Eier nach und nach unterrühren. Nun die geraspelten Karotten und das Vanillemark dazugeben und unterrühren. Nun die restlichen trockenen Zutaten miteinander vermischen und abwechseln mit der Buttermilch unter den Karottenteig rühren.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 1,
					"phrase": "Zucker",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 2,
					"phrase": "Eier",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 11,
					"phrase": "Buttermilch",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Den Teig in gefettete Springform geben und ca. 40 - 50 Minuten backen - Stäbchenprobe. Dann den Kuchen in der Form ca. 20 Minuten auskühlen lassen und dann aus der Form nehmen und auf einen Kuchenteller setzen und vollständig abkühlen lassen.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Die Sahne, den Frischkäse und den Puderzucker, das Vanillemark und den Limettenabrieb in eine Schüssel geben und cremig aufschlagen - geht am besten mit dem Handmixer. Das Frosting dann auf dem Kuchen verteilen.",
			"section": null,
			"timer": null,
