	"steps": [
		{
			"text": "Zuerst die Bolognesesauce zubereiten: Dafür Zwiebeln und Knoblauch schälen und fein hacken. Die Karotten schälen und raspeln.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Dann Öl in einem Topf erhitzen, Zwiebeln, Knoblauch und Karotten darin glasig andünsten, Faschiertes zugeben und für rund 4-6 Minuten weiter anbraten.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Nun geschälte Tomaten und Tomatenmark sowie das Ketchup, Basilikum, Oregano, Thymian, Salz und Pfeffer einrühren und auf kleinster Stufe ca. 10 Minuten köcheln lassen.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 19,
					"phrase": "Tomatenmark",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Anschließend die Bechamelsauce herstellen: Dafür Butter in einem Topf zerlassen, Mehl zufügen und sofort mit einem Schneebesen umrühren. Jetzt ganz langsam unter ständigem Rühren die Milch zufügen. Langsam aufkochen und rühren bis die Sauce dicklich ist - mit Pfeffer, Salz und Muskat würzen.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 3,
					"phrase": "Butter",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 4,
					"phrase": "Milch",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Für die Lasagne eine Auflaufform mit Olivenöl einfetten. Nun abwechselnd die Lasagneblätter und Bolognesesauce einschichten. Mit den Lasagneblättern beginnen, danach die Sauce usw. abwechselnd schichten.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 1,
					"phrase": "Lasagneblätter",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Ganz zum Schluss mit der Bechamelsauce abschließen und frisch geriebenen Gouda draufgeben.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 0,
					"phrase": "Gouda",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Die Lasagne im vorgeheizten Backofen bei 180° C Heißluft (oder 200 Grad Ober-Unterhitze) für rund 30 Minuten backen.",
			"section": null,
			"timer": null,
			"uses": []
		}
	],
