	"steps": [
		{
			"text": "Heat oil in a large heavy based pot over medium heat. Add garlic, onion, celery and carrots. Cook for 10 minutes until softened and sweet - they should not brown (if they do, turn heat down).",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 1,
					"phrase": "onion",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 2,
					"phrase": "medium",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 3,
					"phrase": "celery",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 4,
					"phrase": "garlic",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Add beef, turn heat up and cook the beef, breaking it up as you go.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 5,
					"phrase": "beef",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 9,
					"phrase": "beef",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Once the beef has all turned brown, add the remaining Ragu ingredients EXCEPT the sugar.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 5,
					"phrase": "beef",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 9,
					"phrase": "beef",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Stir then adjust the heat so it is bubbling very gently. Place the lid on and cook for 1.5 - 2 hours, stirring every now and then, then remove the lid and simmer for 30 minutes.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "The ragu is ready when the meat is really tender and the sauce has thickened and is rich - see video for consistency (Note 6). Adjust salt and pepper to taste, and add sugar if required (Note 3)",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 20,
					"phrase": "salt",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Warm milk up in a saucepan (optional - just makes sauce thicken faster).",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "In a large saucepan, melt butter over medium low heat. Add flour and mix constantly for 1 minute.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 2,
					"phrase": "medium",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Pour about 1 cup of the milk in, mixing as you go to incorporate into the flour mixture. Once mostly lump free, add remaining milk. Use a whisk if needed to make it lump free.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 7,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 8,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 16,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Turn heat up to medium high. Stir occasionally at first then regularly after a few minutes until sauce thickens - about 5 - 8 minutes. It should coat the back of the wooden spoon.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 2,
					"phrase": "medium",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Remove from heat, add cheese, nutmeg, salt and pepper. Mix until the cheese is melted. The Sauce should be thick but still easily pourable - the consistency of heavy cream (you need to be able to drizzle it over the Ragu when layering - see video). If it's too thick, add a splash of water or milk.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 20,
					"phrase": "salt",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Preheat oven to 180°C/350°F.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Use a 33 x 22 x 7 cm / 13 x 9 x 2.5\" baking dish.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Smear a bit of Ragu on the base, then cover with lasagna sheets. Tear sheets to fit.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Spread over 2 1/2 cups of Ragu (enough to cover sheets), then drizzle over 1 cup of Cheese Sauce.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 7,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 8,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 16,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 17,
					"phrase": "cups",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 18,
					"phrase": "cups",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 22,
					"phrase": "cups",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Top with lasagna sheets (Note 7). Spread with another 2 1/2 cups of Ragu, then 1 cup of Cheese Sauce. Top with lasagna sheets then repeat 1 more time.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 7,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 8,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 16,
					"phrase": "cup",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 17,
					"phrase": "cups",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 18,
					"phrase": "cups",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 22,
					"phrase": "cups",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Top with a 4th layer of lasagna sheets, then pour over the remaining Cheese Sauce.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Sprinkle with Mozzarella, then bake for 25 minutes or until golden and bubbling.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Stand for 5 to 10 minutes before cutting and serving, garnished with basil or parsley if desired.",
			"section": null,
			"timer": null,
			"uses": []
		}
	],
