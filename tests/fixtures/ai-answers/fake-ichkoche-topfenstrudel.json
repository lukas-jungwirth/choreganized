		},
		{
			"text": "Butter in einem kleinen Topf schmelzen.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 1,
					"phrase": "Butter",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 6,
