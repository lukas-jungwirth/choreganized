					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 10,
					"phrase": "Butter",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Die Arbeitsfläche bemehlen und den Teig dünn auswalken, bis man ihn mit den Händen in alle Richtungen dünn ausziehen kann (das sogenannte \"Strudelziehen\").",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Den Strudelteig auf die bemehlte Arbeitsfläche legen und mit der geschmolzenen Butter bestreichen.",
			"section": null,
			"timer": null,
			"uses": [
				{
					"ingredient": 1,
					"phrase": "Butter",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 6,
					"phrase": "Butter",
					"amountPhrase": null,
					"quantity": null
				},
				{
					"ingredient": 10,
					"phrase": "Butter",
					"amountPhrase": null,
					"quantity": null
				}
			]
		},
		{
			"text": "Die Topfenfülle im unteren Drittel platzieren und mit den Rosinen bestreuen. Die Enden einschlagen und den Strudel gut zusammenrollen, damit die Fülle während des Backens nicht ausrinnen kann.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Ein Backblech mit Backpapier belegen und den Topfenstrudel mit der Naht nach unten vorsichtig raufheben.",
			"section": null,
			"timer": null,
			"uses": []
		},
		{
			"text": "Ei verquirlen und mit der übriggebliebenen geschmolzenen Butter vermengen. Den Topfenstrudel damit bestreichen und für ca. 20-25 Minuten bei 180 °C backen.",
			"section": null,
			"timer": null,
			"uses": [
