	"steps": [
		{
			"text": "Das Suppengrün putzen und sehr fein würfeln. Zwiebel und Knoblauch hacken. Den Speck würfeln.",
			"section": "Bolognesesoße",
			"timer": null,
			"uses": [
				{ "ingredient": 0, "phrase": "Suppengrün", "amountPhrase": null, "quantity": null },
				{ "ingredient": 1, "phrase": "Zwiebel", "amountPhrase": null, "quantity": null },
				{ "ingredient": 2, "phrase": "Knoblauch", "amountPhrase": null, "quantity": null },
				{ "ingredient": 3, "phrase": "Speck", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Das Olivenöl in einer Pfanne erhitzen. Speck, Suppengrün, Zwiebel und Knoblauch anbraten, bis es glasig ist.",
			"section": "Bolognesesoße",
			"timer": null,
			"uses": [
				{ "ingredient": 4, "phrase": "Olivenöl", "amountPhrase": null, "quantity": null },
				{ "ingredient": 3, "phrase": "Speck", "amountPhrase": null, "quantity": null },
				{ "ingredient": 0, "phrase": "Suppengrün", "amountPhrase": null, "quantity": null },
				{ "ingredient": 1, "phrase": "Zwiebel", "amountPhrase": null, "quantity": null },
				{ "ingredient": 2, "phrase": "Knoblauch", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Das Hackfleisch dazugeben und krümelig und braun anbraten. Mit Salz und Pfeffer würzen.",
			"section": "Bolognesesoße",
			"timer": null,
			"uses": [
				{ "ingredient": 5, "phrase": "Hackfleisch", "amountPhrase": null, "quantity": null },
				{ "ingredient": 6, "phrase": "Salz", "amountPhrase": null, "quantity": null },
				{ "ingredient": 7, "phrase": "Pfeffer", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Mit Rotwein oder Brühe ablöschen und verdampfen lassen. Die Tomatenstückchen und das Tomatenmark in die Pfanne geben und ca. 10 Minuten köcheln lassen.",
			"section": "Bolognesesoße",
			"timer": { "seconds": 600, "label": "Soße köcheln" },
			"uses": [
				{ "ingredient": 8, "phrase": "Rotwein", "amountPhrase": null, "quantity": null },
				{ "ingredient": 9, "phrase": "Tomatenstückchen", "amountPhrase": null, "quantity": null },
				{ "ingredient": 10, "phrase": "Tomatenmark", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Thymian unterrrühren und die Soße mit Salz, Pfeffer und einer Prise Zucker abschmecken.",
			"section": "Bolognesesoße",
			"timer": null,
			"uses": [
				{ "ingredient": 11, "phrase": "Thymian", "amountPhrase": null, "quantity": null },
				{ "ingredient": 6, "phrase": "Salz", "amountPhrase": null, "quantity": null },
				{ "ingredient": 7, "phrase": "Pfeffer", "amountPhrase": null, "quantity": null },
				{ "ingredient": 12, "phrase": "Zucker", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Die Zwiebel hacken. Die Butter in einem Topf erhitzen und die Zwiebelwürfel und das Mehl darin unter Rühren andünsten.",
			"section": "Béchamelsoße",
			"timer": null,
			"uses": [
				{ "ingredient": 13, "phrase": "Zwiebel", "amountPhrase": null, "quantity": null },
				{ "ingredient": 13, "phrase": "Zwiebelwürfel", "amountPhrase": null, "quantity": null },
				{ "ingredient": 14, "phrase": "Butter", "amountPhrase": null, "quantity": null },
				{ "ingredient": 15, "phrase": "Mehl", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Nach und nach Brühe und Milch in kleinen Portionen zugießen. Zwischendurch mit einem Schneebesen kräftig rühren, damit keine Klümpchen bleiben, die Soße aufkochen lassen.",
			"section": "Béchamelsoße",
			"timer": null,
			"uses": [
				{ "ingredient": 16, "phrase": "Brühe", "amountPhrase": null, "quantity": null },
				{ "ingredient": 17, "phrase": "Milch", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Den Käse grob raspeln und in der Soße schmelzen lassen. Mit Salz, Pfeffer und Muskatnuss abschmecken.",
			"section": "Béchamelsoße",
			"timer": null,
			"uses": [
				{ "ingredient": 18, "phrase": "Käse", "amountPhrase": null, "quantity": null },
				{ "ingredient": 19, "phrase": "Muskatnuss", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Etwas Béchamelsoße auf den Boden einer Auflaufform streichen. Eine Schicht Lasagneblätter darauf geben. Darauf eine Schicht Bolognesesoße geben, mit Lasagneblättern bedecken. So weiter machen, bis die Zutaten verbraucht sind. Mit einer dicken Schicht Béchamelsoße abschließen, damit die Lasagneblätter Feuchtigkeit zum Garen haben.",
			"section": null,
			"timer": null,
			"uses": [
				{ "ingredient": 20, "phrase": "Lasagneblätter", "amountPhrase": null, "quantity": null },
				{ "ingredient": 20, "phrase": "Lasagneblättern", "amountPhrase": null, "quantity": null }
			]
		},
		{
			"text": "Käse grob raspeln und über die Lasagne geben. Im vorgeheizten Backofen bei 175° (Umluft 150°) etwa 50 – 60 Minuten backen.",
			"section": null,
			"timer": { "seconds": 3000, "label": "Lasagne" },
			"uses": [{ "ingredient": 21, "phrase": "Käse", "amountPhrase": null, "quantity": null }]
		}
	],
