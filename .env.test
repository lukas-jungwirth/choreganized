# Loaded by Vite in `test` mode (i.e. under Vitest) on top of `.env`, and checked
# in on purpose — every value here is a stand-in, so a fresh clone runs
# `npm test` with no setup (→ docs/TESTING.md).
#
# The values that must never be real — the database path, the GitHub token,
# the VAPID keys — are NOT trusted to this file: Vite lets the shell and `.env`
# override it, so vite.config.ts forces them under `test` and the fixture in
# tests/helpers/db.ts refuses to run against anything but `:memory:`.
BETTER_AUTH_SECRET=vitest-only-not-a-real-secret-0000000000
BETTER_AUTH_URL=http://localhost:4173
ORIGIN=http://localhost:4173
GOOGLE_CLIENT_ID=vitest-placeholder
GOOGLE_CLIENT_SECRET=vitest-placeholder
