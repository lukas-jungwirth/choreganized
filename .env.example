# ── Core ─────────────────────────────────────────────────────────────────────
# Absolute path in production (Coolify volume), relative is fine in dev.
DATABASE_PATH=./data/choreganized.db
# Directory for uploaded recipe images (must be persisted in production).
UPLOADS_DIR=./data/uploads
# Public origin the app is served from (required by adapter-node for form actions).
ORIGIN=http://localhost:5173

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as ORIGIN in most setups.
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web").
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push ─────────────────────────────────────────────────────────────────
# Generate both with: npx web-push generate-vapid-keys
# The public key is exposed to the client (PUBLIC_ prefix), the private key never is.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service, e.g. mailto:lj@iservice.at
VAPID_SUBJECT=mailto:lj@iservice.at
