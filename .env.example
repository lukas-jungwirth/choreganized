# ── Core ─────────────────────────────────────────────────────────────────────
# Absolute path in production (Coolify volume), relative is fine in dev.
DATABASE_PATH=./data/choreganized.db
# Directory for uploaded recipe images (must be persisted in production).
UPLOADS_DIR=./data/uploads
# Nightly SQLite backups (14-day rotation). Defaults to a `backups/` folder beside
# the DB — i.e. on the /data volume in production. Override only to relocate them.
# BACKUPS_DIR=./data/backups
# Max request body adapter-node will accept. Its default is 512K, which rejects
# every real phone photo before the upload action runs — the dev server has no
# limit, so leaving this unset only breaks the built server (→ DECISIONS).
BODY_SIZE_LIMIT=20M
# Public origin the app is served from (required by adapter-node for form actions).
ORIGIN=http://localhost:5173

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as ORIGIN in most setups.
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web").
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push ─────────────────────────────────────────────────────────────────
# Generate both with: npx web-push generate-vapid-keys
# The public key is exposed to the client (PUBLIC_ prefix), the private key never is.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service, e.g. mailto:lj@iservice.at
VAPID_SUBJECT=mailto:lj@iservice.at

# ── AI recipe import (optional) ──────────────────────────────────────────────
# The Gemini API key is per household (set in Settings, stored in the DB), NOT here.
# This only overrides which model that key calls. Default: gemini-flash-latest — an
# alias Google keeps pointed at the current Flash model, so it survives Google's
# (often early) model retirements. Set a specific id here only if a rotation ever
# breaks the alias, e.g. GEMINI_MODEL=gemini-3.6-flash (→ services/ai-import.ts).
# GEMINI_MODEL=gemini-flash-latest

# ── Feedback → GitHub issues (optional) ──────────────────────────────────────
# A fine-grained personal access token scoped to this one repository, with
# "Issues: Read and write" (plus the mandatory "Metadata: Read") and nothing else.
# Without it feedback still saves — the row is the receipt, and the cron sweep
# mirrors it once a token appears (→ services/feedback.ts, DECISIONS #136).
# Unlike the Gemini key above, this is the *app's* credential for the app's own
# repository, so it lives here rather than per household in the database.
GITHUB_FEEDBACK_TOKEN=
# Only to file issues somewhere else; defaults to lukas-jungwirth/choreganized.
# GITHUB_FEEDBACK_REPO=lukas-jungwirth/choreganized

# ── Build identity ───────────────────────────────────────────────────────────
# What a feedback report says it came from (→ server/version.ts, DECISIONS #137).
# Set by the Dockerfile from build args; unset here, so dev honestly reports "dev".
# Put APP_COMMIT in your own .env if you want a real sha locally.
# APP_VERSION=
# APP_COMMIT=

# ── Tests (never on a deployed instance) ─────────────────────────────────────
# `E2E_MODE=true` enables password sign-in (Better Auth's /api/auth/sign-up/email)
# and the /dev/kit gallery on a production build, so Playwright — and a local
# verification session without a Google account — can mint a session. The
# server warns at boot when it is on. Playwright sets it itself; for a manual
# session use the `verify` entry in .claude/launch.json (→ docs/TESTING.md). The
# server refuses to start with it on any ORIGIN but localhost.
# E2E_MODE=true
