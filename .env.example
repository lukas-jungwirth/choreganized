# ── Core ─────────────────────────────────────────────────────────────────────
# Absolute path in production (Coolify volume), relative is fine in dev.
DATABASE_PATH=./data/choreganized.db
# Directory for uploaded recipe images (must be persisted in production).
UPLOADS_DIR=./data/uploads
# Nightly SQLite backups (14-day rotation). Defaults to a `backups/` folder beside
# the DB — i.e. on the /data volume in production. Override only to relocate them.
# BACKUPS_DIR=./data/backups
# Max request body adapter-node will accept. Its default is 512K, which rejects
# every real phone photo before the upload action runs — the dev server has no
# limit, so leaving this unset only breaks the built server (→ DECISIONS).
BODY_SIZE_LIMIT=20M
# Public origin the app is served from (required by adapter-node for form actions).
ORIGIN=http://localhost:5173

# ── Off-site replication: Litestream (container only, optional) ──────────────
# Read by the Docker image's start script, not by the app (→ docs/BACKUP.md). Set all six
# and the container restores an empty /data from the replica, then replicates the DB
# continuously. Set none and it starts without Litestream (local dev, tests and e2e never
# need them). Set only some and the container refuses to start.
# Placeholders only. The real key lives in Coolify, never in a file.
# LITESTREAM_ACCESS_KEY_ID=<b2-key-id>
# LITESTREAM_SECRET_ACCESS_KEY=<b2-application-key>
# The bucket's S3 endpoint, with https://. B2 shows it on the bucket page.
# LITESTREAM_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# LITESTREAM_S3_BUCKET=lj-dev-backup
# The region is the endpoint's middle part.
# LITESTREAM_S3_REGION=eu-central-003
# One prefix per instance. Two instances writing to the same one break each other's restore.
# LITESTREAM_REPLICA_PATH=choreganized/staging

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as ORIGIN in most setups.
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web").
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push ─────────────────────────────────────────────────────────────────
# Generate both with: npx web-push generate-vapid-keys
# The public key is exposed to the client (PUBLIC_ prefix), the private key never is.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service, e.g. mailto:lj@iservice.at
VAPID_SUBJECT=mailto:lj@iservice.at

# ── AI features ──────────────────────────────────────────────────────────────
# Nothing to set here: each household brings its own provider key (Gemini, OpenAI,
# Anthropic or OpenRouter) and picks the model in Settings → AI features; both are
# stored in the DB (→ docs/DECISIONS.md #146). GEMINI_MODEL is retired.
# Test-only: AI_GEMINI_BASE_URL / AI_OPENAI_BASE_URL / AI_ANTHROPIC_BASE_URL /
# AI_OPENROUTER_BASE_URL point a provider at scripts/fake-ai.ts — honoured only
# with E2E_MODE=true, so they can never redirect a real household's key.

# ── Feedback → GitHub issues (optional) ──────────────────────────────────────
# A fine-grained personal access token scoped to this one repository, with
# "Issues: Read and write" (plus the mandatory "Metadata: Read") and nothing else.
# Without it feedback still saves — the row is the receipt, and the cron sweep
# mirrors it once a token appears (→ services/feedback.ts, DECISIONS #136).
# Unlike the households' AI keys, this is the *app's* credential for the app's own
# repository, so it lives here rather than per household in the database.
GITHUB_FEEDBACK_TOKEN=
# Only to file issues somewhere else; defaults to lukas-jungwirth/choreganized.
# GITHUB_FEEDBACK_REPO=lukas-jungwirth/choreganized

# ── Email (sign-in codes, plan 31) ───────────────────────────────────────────
# Any SMTP provider (Brevo, Postmark, Resend, Scaleway, your own server). With
# SMTP_HOST and MAIL_FROM set the login page offers "Email me a code"; without
# them it shows Google alone. 465 = TLS from the start, anything else (587) must
# upgrade with STARTTLS or the mail isn't sent. Set SPF/DKIM/DMARC for MAIL_FROM's
# domain at the provider, or the codes land in spam (→ lib/server/mail.ts).
# In `npm run dev` with no SMTP the code is printed to the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Choreganized <noreply@example.com>"
MAIL_FROM=
# Dev/E2E only: write each mail as a JSON line to this file instead of sending it
# (Playwright reads the code from it). Ignored on a deploy.
# MAIL_OUTBOX=./data/outbox.jsonl

# ── Build identity ───────────────────────────────────────────────────────────
# What a feedback report says it came from (→ server/version.ts, DECISIONS #137).
# Set by the Dockerfile from build args; unset here, so dev honestly reports "dev".
# Put APP_COMMIT in your own .env if you want a real sha locally.
# APP_VERSION=
# APP_COMMIT=

# ── Tests (never on a deployed instance) ─────────────────────────────────────
# `E2E_MODE=true` enables password sign-in (Better Auth's /api/auth/sign-up/email)
# and the /dev/kit gallery on a production build, so Playwright — and a local
# verification session without a Google account — can mint a session. The
# server warns at boot when it is on. Playwright sets it itself; for a manual
# session use the `verify` entry in .claude/launch.json (→ docs/TESTING.md). The
# server refuses to start with it on any ORIGIN but localhost.
# E2E_MODE=true
